node_modules/
dist/

# The gate runner's staleness record (`npm run gates:status`). A fact about this
# machine and this checkout — when each arm last ran here and what it said — not
# a fact about the code, so it would conflict on every merge if committed.
.gates/
dist-desktop/

# Externally-authored mesh kits, fetched by hand for the #59 import seam and
# read by `tools/kitprobe.mjs`. Nothing binary is committed until issue #26
# closes and a pack is actually chosen; `src/world/ModelKit.js` takes the model
# URL as an argument precisely so no asset has to live in the tree to test it.
# The fetch command for the one model the probe expects is in kitprobe's header.
assets/kit/

# Local build config. `.env.example` is the committed template; a real `.env`
# carries TURN credentials and must not be.
.env
.env.*
!.env.example
# Two-seat check (#242): machine A's local config (host, user, key path) and
# machine B's per-run file.
.twoseat.local.json
.twoseat/
shots/
.codegraph/
*.log
shots-*/
dist/

# Critic-round screenshots. The written reviews and manifests are the artefact
# worth keeping; the captures are regenerable and were flooding `git status`
# with hundreds of untracked PNGs per round.
reviews/**/*.png
reviews/**/*.jpg

# Exception: the #59 mesh-import seam's measured crops. Two ratified documents
# (`docs/ART-STYLE-GUIDE.md`, `docs/art/ASSET-SPEC.md`) quote numbers read off
# these exact pixels, and the rule above is why the evidence was left in a
# disposable agent worktree instead. The crops are ~265 KB in total and are NOT
# regenerable without first re-downloading a third-party asset (#26), which is
# the difference from every other capture this rule covers. The full 1600x900
# frames they were cut from are still ignored — those are the megabytes.
!reviews/modelkit-seam/crop-*.png

# Round-6 scratch captures (intermediate agent runs; manifests are committed)
reviews/round6/dbg*/
reviews/round6/fix[A-D]/
reviews/round6/diag-*.json
reviews/round6/realms-w*/
reviews/round6/vfx-t*/

# The shot library's clips. The stills in `shotlib/` are committed on purpose
# (see `shotlib/MANIFEST.md`); the clips are not — webm at 1600x900 does not
# belong in git history, and every take is regenerable from the command its
# manifest entry records. This is the directory `tools/clipshot.mjs` writes to,
# so it covers the `.webm` and its record JSON both.
shotlib/clips/

# The Steamworks SDK download itself — 24 MB, and 269 of its 270 entries are
# headers, samples and content-builder tools we never use. Only the one file the
# Binding actually loads is vendored, under `steamworks_sdk/`, which IS committed
# (see `docs/STEAM.md` section 8.6). Note the SDK zip also carries six stray
# `steam_appid.txt` files under `sdk/steamworksexample/`, which is a second reason
# not to unpack it into the tree wholesale.
steamworks_sdk_*.zip

# Staging for the #109 art evaluation set. Nothing binary enters git until #26 closes.
assets-staging/

# Downloaded asset shortlists and the runner-up cache. The 2026-08-21 "leftovers"
# commit swept 775 MiB of these into history and had to be filter-branched back
# out; the ignore is the guard that stops the next bulk `git add .` from repeating
# it. Supersedes the narrower `assets/kit/` rule above.
assets/

# The controller's briefs, task reports and reviews — gitignored working material
# per CLAUDE.md's table; the same 2026-08-21 sweep committed 12 of them.
.superpowers/
