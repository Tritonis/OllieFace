{
  "name": "telluric-void",
  "version": "1.0.0",
  "description": "",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "test": "node tests/run.mjs",
    "gate:elite": "node tests/sp-equivalence.mjs --mode elite-dps --compare reviews/round8/elite-baseline-HEAD.json",
    "build": "vite build",
    "preview": "vite preview",
    "shots": "node tools/capture.mjs",
    "dev:lan": "vite --host",
    "signal": "node tools/signal-server.mjs",
    "desktop": "npm run build && electron .",
    "desktop:run": "electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.olliface.telluricvoid",
    "productName": "TELLURIC VOID",
    "asar": false,
    "directories": { "output": "dist-desktop" },
    "files": ["desktop/**", "dist/**", "!dist/**/*.map", "package.json", "!node_modules/**"],
    "win": { "target": "dir", "signAndEditExecutable": false }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
  },
  "type": "module",
  "private": true
}
