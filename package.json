{
  "name": "telluric-void",
  "version": "1.0.0",
  "description": "",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "test": "node tests/run.mjs",
    "postinstall": "install-electron",
    "gates:cheap": "node tools/gates.mjs cheap",
    "gates:heavy": "node tools/gates.mjs heavy",
    "gates:status": "node tools/gates.mjs status",
    "gate:sp": "node tests/sp-equivalence.mjs --compare reviews/round7/baseline-00f8900.json",
    "gate:elite": "node tests/sp-equivalence.mjs --mode elite-dps --compare reviews/round7/elite-baseline-a55986b.json",
    "gate:mp1": "node tests/sp-equivalence.mjs --coop-host --compare reviews/round7/baseline-00f8900.json",
    "build": "vite build",
    "preview": "vite preview",
    "shots": "node tools/capture.mjs",
    "padprobe": "node tools/padprobe.mjs",
    "probe:coop": "node tools/coopprobe.mjs",
    "probe:trickle": "node tools/verify-trickle.mjs",
    "baseline:net": "node tools/netbaseline.mjs --peers 3 --hz 60 --entities 60 --run-s 30 --warmup-s 3 --label webrtc-3peer-60hz",
    "dev:lan": "vite --host",
    "signal": "node tools/signal-server.mjs",
    "desktop": "npm run build && electron .",
    "desktop:run": "electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "steamsdk": "node tools/steamsdk.mjs",
    "steamsdk:electron": "electron tools/steam-electron-init.mjs",
    "smoke:steam": "node tools/steamsmoke.mjs --peers 3 --hz 60 --entities 60 --run-s 30 --warmup-s 3 --label steam-socketpair-3peer-60hz",
    "smoke:steam:binding": "electron tools/steamsmoke.mjs --via binding --peers 3 --hz 60 --entities 60 --run-s 30 --warmup-s 3 --label steam-binding-electron-3peer-60hz"
  },
  "build": {
    "appId": "com.olliface.telluricvoid",
    "productName": "TELLURIC VOID",
    "asar": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/three/**",
      "!node_modules/ws/**",
      "steamworks_sdk/redistributable_bin/win64/steam_api64.dll",
      "!**/steam_appid.txt"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "koffi": "^3.1.5",
    "steamworks-ffi-node": "0.11.1",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
  },
  "type": "module",
  "private": true
}
